---
// pages/articles/[id].astro
import '../../../styles/utils.css';

export async function getStaticPaths() {
  const response = await fetch('https://my-endpoints.onrender.com/blog/articles');
  const articles = await response.json();
  
  return articles.map((article) => ({
    params: { id: String(article._id) },
  }));
}

const { id } = Astro.params;
const basePath = import.meta.env.BASE_URL;

const response = await fetch(`https://my-endpoints.onrender.com/blog/articles/${id}`);
const article = await response.json();
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{article.title}</title>
  </head>
  <body>
    <header>
      <a href={`${basePath}/blog`} style="color: #38bdf8; text-decoration: none; display: inline-block; margin-bottom: 1rem;">
        &larr; Torna al Blog
      </a>
      
      <h1>{article.title}</h1>
      <p class="tagline">Pubblicato il: {article.publicationDate || article.creationDate}</p>
    </header>

    <main>
      <article class="card">
        <div set:html={article.description} />
      </article>
    </main>
  </body>
</html>