---
// pages/blog.astro
import '../../styles/utils.css';

const title = "Il mio Blog";
const basePath = import.meta.env.BASE_URL; 

// Chiamata all'API per recuperare la lista degli articoli
const response = await fetch('https://my-endpoints.onrender.com/blog/articles');
const articles = await response.json();
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <h1>{title}</h1>
      <p class="tagline">Pensieri, tutorial e risorse sullo sviluppo web.</p>
    </header>

    <main>
      <!-- Filtriamo magari solo quelli con status: true, se ti serve -->
      {articles.filter(article => article.status).map((article) => (
        <article class="card">
          <h2 style="margin-top: 0; color: #f8fafc;">
            <!-- L'URL ora punta alla rotta dinamica usando l'_id -->
            <a href={`${basePath}/article/${article._id}`} style="color: inherit; text-decoration: none;">
              {article.title}
            </a>
          </h2>
          <p class="tagline" style="font-size: 0.9rem; margin-bottom: 1rem;">
            {article.publicationDate || article.creationDate || "Data non disponibile"}
          </p>
          <p style="margin: 0; color: #cbd5e1; white-space: pre-line;">
            <!-- Mostra l'abstract, se vuoto mostra un pezzo della descrizione -->
            {article.abstract || (article.description ? article.description.substring(0, 100) + '...' : '')}
          </p>
          <div style="margin-top: 1rem;">
            <a href={`${basePath}/blog/article/${article._id}`} style="color: #38bdf8; text-decoration: none; font-weight: bold;">
              Leggi di più &rarr;
            </a>
          </div>
        </article>
      ))}
    </main>
  </body>
</html>