---
// pages/index.astro
import '../styles/utils.css';

const title = "Il mio Giardino Digitale";
const role = "Team Leader & Developer Angular";
const university = "Studente alla Sapienza - Informatica";

// Recuperiamo il base path per i link (evita l'errore 404 su GitHub Pages)
const basePath = import.meta.env.BASE_URL;
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			.nav-link {
				color: #38bdf8;
				text-decoration: none;
			}
			.nav-link:hover {
				text-decoration: underline;
			}
			.nav-section {
				margin-top: 2rem;
			}
		</style>
	</head>
	<body>
		<header>
			<h1>{title}</h1>
			<p class="tagline">{role} | {university}</p>
		</header>
		
		<main>
			<section class="card">
				<h2 style="margin-top: 0;">Benvenuto nel mio spazio</h2>
				<p style="margin-bottom: 0;">
					Questo è il mio giardino digitale in costruzione, realizzato con Astro. 
					Qui racconterò la mia esperienza con Angular, la gestione dei team e il mio percorso universitario.
				</p>
			</section>

			<!-- Trasformiamo il footer in una vera sezione di navigazione con le card -->
			<section class="nav-section">
				<h2>Esplora il sito</h2>
				
				<div class="card">
					<h3 style="margin-top: 0; margin-bottom: 0.5rem;">
						👨‍💻 <a href={`${basePath}/portfolio`} class="nav-link">Portfolio</a>
					</h3>
					<p style="margin: 0; color: #cbd5e1;">Scopri chi sono, le mie competenze e i progetti su cui ho lavorato.</p>
				</div>
				
				<div class="card">
					<h3 style="margin-top: 0; margin-bottom: 0.5rem;">
						📝 <a href={`${basePath}/blog`} class="nav-link">Blog</a>
					</h3>
					<p style="margin: 0; color: #cbd5e1;">Leggi i miei appunti, riflessioni e articoli sul mondo dello sviluppo.</p>
				</div>
			</section>
		</main>
	</body>
</html>