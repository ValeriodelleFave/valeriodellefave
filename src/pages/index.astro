---
// Qui puoi inserire logica JavaScript/TypeScript se ti serve
const title = "Il mio Giardino Digitale";
const role = "Team Leader & Developer Angular";
const university = "Studente alla Sapienza - Informatica";
import '../styles/utils.css';
---

<html lang="it">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<h1>{title}</h1>
			<p class="tagline">{role} | {university}</p>
		</header>
		
		<main>
			<section class="card">
				<h2>Benvenuto nel mio spazio</h2>
				<p>Questo è il mio giardino digitale in costruzione, realizzato con Astro. Qui racconterò la mia esperienza con Angular, la gestione dei team e il mio percorso universitario.</p>
			</section>
		</main>
		<footer class="card">
			<h2>Sezioni:</h2>
			<p>Read more <a href="valeriodellefave/portfolio/">about</a> me!</p>
			<p>Read more <a href="valeriodellefave/blog/">about</a> my blog!</p>
		</footer>
	</body>
</html>
